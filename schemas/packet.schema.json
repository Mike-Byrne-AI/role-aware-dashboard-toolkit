{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Role-Aware Dashboard Toolkit Packet",
  "type": "object",
  "required": [
    "schema_version",
    "packet_type",
    "packet_id",
    "exported_at",
    "source_app",
    "source_version",
    "payload_schema_version",
    "payload",
    "meta"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "packet_type": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "exported_at": {"type": "string"},
    "source_app": {"type": "string", "minLength": 1},
    "source_version": {"type": "string"},
    "payload_schema_version": {"type": "integer", "minimum": 1},
    "payload": {"type": "object"},
    "meta": {"type": "object"},
    "extensions": {"type": "object"}
  },
  "additionalProperties": false
}
