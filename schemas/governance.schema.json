{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Role-Aware Dashboard Toolkit Governance Record",
  "type": "object",
  "required": ["schema_version", "governance_id", "case_id", "state", "policy_checks"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "governance_id": {"type": "string"},
    "case_id": {"type": "string"},
    "state": {"type": "string", "enum": ["admissible", "needs_review", "escalated", "blocked", "replay_only"]},
    "severity": {"type": "string"},
    "escalation_level": {"type": "string", "enum": ["none", "review", "approver", "admin", "emergency"]},
    "policy_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "title", "result"],
        "properties": {
          "check_id": {"type": "string"},
          "title": {"type": "string"},
          "result": {"type": "string", "enum": ["pass", "warn", "fail", "waived"]},
          "detail": {"type": "string"},
          "blocker": {"type": "boolean"}
        }
      }
    },
    "approval_requirements": {"type": "array", "items": {"type": "string"}},
    "blocked_actions": {"type": "array", "items": {"type": "string"}},
    "allowed_next_actions": {"type": "array", "items": {"type": "string"}},
    "history": {"type": "array"}
  }
}
