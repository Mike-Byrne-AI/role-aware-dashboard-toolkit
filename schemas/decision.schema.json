{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Role-Aware Dashboard Toolkit Decision Case",
  "type": "object",
  "required": [
    "schema_version",
    "decision_id",
    "run_id",
    "checkpoint_id",
    "created_at",
    "updated_at",
    "state",
    "approval_state",
    "history",
    "allowed_actions",
    "blockers"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "decision_id": {"type": "string"},
    "run_id": {"type": "string"},
    "checkpoint_id": {"type": "string"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "state": {
      "type": "string",
      "enum": [
        "proposed",
        "review_requested",
        "in_review",
        "changes_requested",
        "approved",
        "rejected",
        "frozen",
        "replay_only",
        "handoff_pending",
        "handed_off",
        "closed"
      ]
    },
    "approval_state": {"type": "string"},
    "latest_signoff_decision": {"type": "string"},
    "latest_handoff_status": {"type": "string"},
    "open_assignment_count": {"type": "integer"},
    "comment_count": {"type": "integer"},
    "signoff_count": {"type": "integer"},
    "handoff_count": {"type": "integer"},
    "blockers": {"type": "array", "items": {"type": "object"}},
    "allowed_actions": {"type": "array", "items": {"type": "string"}},
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_type": {
            "type": "string",
            "enum": [
              "decision_created",
              "approval_synced",
              "review_requested",
              "review_started",
              "signoff_recorded",
              "handoff_created",
              "handoff_accepted",
              "handoff_closed",
              "decision_closed",
              "decision_reopened"
            ]
          }
        }
      }
    },
    "summary": {"type": "object"},
    "tags": {"type": "array", "items": {"type": "string"}}
  }
}
