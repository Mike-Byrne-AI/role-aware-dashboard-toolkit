{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Role-Aware Dashboard Toolkit Ledger",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "run_id",
    "entries",
    "latest_controls"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "generated_at": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_sequence": {
            "type": "integer",
            "minimum": 0,
            "description": "Optional original entry position before chronological sorting. Complete unique values preserve source order for reconstruction; legacy ledgers may omit this field."
          }
        }
      }
    },
    "latest_controls": {
      "type": "object"
    }
  }
}
